# Гриф: Waveshare ESP32-S3-Touch-LCD-3.49 V2 (ESP32-S3R8, 16 МБ flash, 8 МБ OCT PSRAM).
# Значения сверены с демо-проектом платы из репозитория производителя.
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y

# 1 кГц тика: слой управления работает на 200 Гц, нужна дискретность 1 мс.
CONFIG_FREERTOS_HZ=1000

# Оптимизация по скорости: бюджет аудиоблока 2.67 мс, размером образа не жмёт.
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# Полная частота вместо умолчания в 160 МГц. Гриф считает физическую модель
# четырёх струн в реальном времени — это единственное на плате, чему процессора
# может не хватить, и полтора раза запаса берутся здесь бесплатно.
# Плата за это — питание, им займётся фаза 6; смычок остаётся на 160 МГц,
# ему считать нечего.
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# Оба ядра заняты по назначению: 1 — звук, 0 — управление и ввод-вывод.
CONFIG_FREERTOS_UNICORE=n

# Радио — на ядре 0, вместе с остальным вводом-выводом. Ядро 1 отдано звуку
# целиком, и задача Wi-Fi там не нужна (значение совпадает с умолчанием IDF,
# но здесь оно часть распределения ядер, а не случайность).
CONFIG_ESP_WIFI_TASK_PINNED_TO_CORE_0=y
